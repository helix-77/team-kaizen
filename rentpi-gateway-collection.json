{
	"info": {
		"_postman_id": "rentpi-unified-gateway",
		"name": "RentPi - Unified Gateway (Port 8000)",
		"description": "All requests in this collection are routed through the API Gateway on Port 8000.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "User Service (via Gateway)",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"TestUser\",\n    \"email\": \"tester@rentpi.com\",\n    \"password\": \"Pass1234\"\n}"
						},
						"url": "http://127.0.0.1:8000/users/register"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"tester@rentpi.com\",\n    \"password\": \"Pass1234\"\n}"
						},
						"url": "http://127.0.0.1:8000/users/login"
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "http://127.0.0.1:8000/users/me"
					}
				},
				{
					"name": "Get Discount",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/users/1/discount"
					}
				}
			]
		},
		{
			"name": "Rental Service (via Gateway)",
			"item": [
				{
					"name": "List Products",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/rentals/products?category=TOOLS&page=1&limit=10"
					}
				},
				{
					"name": "Check Availability",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/rentals/products/1/availability?from=2024-01-01&to=2024-12-31"
					}
				},
				{
					"name": "Kth Busiest Date",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/rentals/kth-busiest-date?from=2024-01&to=2024-12&k=3"
					}
				}
			]
		},
		{
			"name": "Analytics Service (via Gateway)",
			"item": [
				{
					"name": "Peak Window",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/analytics/peak-window?from=2024-01&to=2024-12"
					}
				},
				{
					"name": "Surge Days",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/analytics/surge-days?month=2024-05"
					}
				},
				{
					"name": "Recommendations",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/analytics/recommendations?date=2024-05-01&limit=5"
					}
				}
			]
		},
		{
			"name": "Agentic Service (via Gateway)",
			"item": [
				{
					"name": "Chat",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"What are the trending products?\"\n}"
						},
						"url": "http://127.0.0.1:8000/chat"
					}
				},
				{
					"name": "List Sessions",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/chat/sessions"
					}
				},
				{
					"name": "Get History",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/chat/SESSION_ID_HERE/history"
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "token", "value": "YOUR_JWT_HERE" }
	]
}
